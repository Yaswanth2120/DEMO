{
  "name": "nexafive-global",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "build:netlify": "npm run build",
    "preview:netlify": "npm run build:netlify && netlify dev --filter @nexafive/frontend",
    "check:netlify": "netlify build --offline --filter @nexafive/frontend"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.6",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^27.14.3"
  },
  "packageManager": "npm@10.9.8"
}
